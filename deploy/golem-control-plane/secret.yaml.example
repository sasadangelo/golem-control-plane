# Copy this file to secret.yaml, fill in real values, then apply:
#   kubectl apply -f deploy/golem-control-plane/secret.yaml
#
# NEVER commit secret.yaml — it is listed in .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: golem-watsonx-credentials
  namespace: golem-system
type: Opaque
stringData:
  WATSONX_API_KEY: "your-api-key-here"  # pragma: allowlist secret
  WATSONX_URL: "https://us-south.ml.cloud.ibm.com"
  WATSONX_PROJECT_ID: "your-project-id-here"
  WATSONX_MODEL_ID: "openai/gpt-oss-120b"
