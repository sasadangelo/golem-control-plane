# Environment variables for local development / docker run
# Copy to .env and fill in real values — never commit secrets

# ---------------------------------------------------------------------------
# IBM WatsonX credentials
# ---------------------------------------------------------------------------
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Agent configuration
# ---------------------------------------------------------------------------
# Unique agent ID (auto-generated at startup if not set)
AGENT_ID=golem-agent-001

# Human-readable name and description (used in the A2A Agent Card)
AGENT_NAME=Golem Agent Runner
AGENT_DESCRIPTION=Generic automation agent powered by Golem.

# Public endpoint of this container (used in the A2A Agent Card)
AGENT_ENDPOINT=http://localhost:8001

# The agent's persona and instructions
SYSTEM_PROMPT=You are a helpful generic automation agent.

# Comma-separated list of skills to enable: bash, http_check
ENABLED_SKILLS=bash,http_check
